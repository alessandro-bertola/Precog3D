; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Precog 3D"
run/main_scene="res://ui/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Conventions="*res://autoload/conventions.gd"
DebugMode="*res://autoload/debug_mode.gd"
App="*res://autoload/app.gd"
MCPRuntime="*res://addons/godot_mcp/runtime/mcp_runtime.gd"

[display]

window/size/viewport_width=1600.0
window/size/viewport_height=900.0
window/size/window_width_override=1600.0
window/size/window_height_override=900.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Precog 3D"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

network/port=6525

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
